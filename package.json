{
  "name": "stellarcheckout",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source payment infrastructure on Stellar",
  "workspaces": ["backend", "frontend", "sdk"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend && npm run build --workspace=sdk",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "8.2.2"
  }
}
